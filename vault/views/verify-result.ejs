<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
<div class="auth-wrap" style="grid-template-columns:1fr">
  <div class="auth-form-col">
    <div class="auth-card" style="text-align:center">
      <div style="font-size:2.6rem;margin-bottom:12px"><%= ok ? '✅' : '❌' %></div>
      <h2><%= ok ? 'Adresse confirmée !' : 'Lien invalide' %></h2>
      <p class="sub"><%= ok ? 'Tu peux maintenant te connecter.' : 'Ce lien est invalide ou déjà utilisé.' %></p>
      <a class="btn" href="/login">Se connecter</a>
    </div>
  </div>
</div>
</body>
</html>
