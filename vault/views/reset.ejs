<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Nouveau mot de passe · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
<div class="auth-wrap" style="grid-template-columns:1fr">
  <div class="auth-form-col">
    <% if (!valid) { %>
      <div class="auth-card" style="text-align:center">
        <h2>Lien invalide</h2>
        <p class="sub">Ce lien a expiré ou est invalide. Refais une demande.</p>
        <a class="btn" href="/forgot">Nouvelle demande</a>
      </div>
    <% } else if (done) { %>
      <div class="auth-card" style="text-align:center">
        <div style="font-size:2.6rem;margin-bottom:12px">✅</div>
        <h2>Mot de passe changé</h2>
        <a class="btn" href="/login">Se connecter</a>
      </div>
    <% } else { %>
      <form class="auth-card" method="POST" action="/reset">
        <h2>Nouveau mot de passe</h2>
        <p class="sub">Choisis un nouveau mot de passe pour ton compte.</p>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <input type="hidden" name="token" value="<%= token %>" />
        <div class="field"><label>Mot de passe</label><input type="password" name="password" minlength="8" required autofocus /></div>
        <button class="btn" type="submit">Réinitialiser</button>
      </form>
    <% } %>
  </div>
</div>
</body>
</html>
