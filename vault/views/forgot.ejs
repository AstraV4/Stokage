<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Mot de passe oublié · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
<div class="auth-wrap" style="grid-template-columns:1fr">
  <div class="auth-form-col">
    <% if (done) { %>
      <div class="auth-card" style="text-align:center">
        <div style="font-size:2.6rem;margin-bottom:12px">📬</div>
        <h2>Vérifie ta boîte mail</h2>
        <p class="sub">Si un compte existe avec cette adresse, un lien de réinitialisation vient d'être envoyé.</p>
        <a class="btn" href="/login">Retour à la connexion</a>
      </div>
    <% } else { %>
      <form class="auth-card" method="POST" action="/forgot">
        <h2>Mot de passe oublié</h2>
        <p class="sub">Indique ton e-mail, on t'envoie un lien pour le réinitialiser.</p>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <div class="field"><label>E-mail</label><input type="email" name="email" required autofocus /></div>
        <button class="btn" type="submit">Envoyer le lien</button>
        <p class="switch-link"><a href="/login">Retour à la connexion</a></p>
      </form>
    <% } %>
  </div>
</div>
</body>
</html>
