<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><link rel="icon" href="/static/img/favicon.png" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= group.name %> · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css?v=8" />
<link rel="stylesheet" href="/static/css/vault.css?v=8" />
<link rel="stylesheet" href="/static/css/social.css?v=8" />
<style>
  .group-layout{display:grid;grid-template-columns:1fr 240px;height:calc(100vh - 66px)}
  @media(max-width:760px){.group-layout{grid-template-columns:1fr}.group-side{display:none}}
  .group-side{border-left:1px solid var(--border);padding:16px;overflow-y:auto}
  .group-side h4{font-size:.78rem;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
  .add-member-row{display:flex;gap:6px;margin-top:14px}
  .add-member-row input{flex:1;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);font-size:.8rem}
  .add-member-row button{background:var(--accent);border:none;color:var(--accent-ink);padding:0 12px;border-radius:8px;font-size:.78rem}
</style>
</head>
<body data-theme="<%= me.theme || 'dark' %>">
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="app">
    <%- include('_sidebar', { active: 'groups' }) %>
    <div class="main">
      <div class="group-layout">
        <div class="chat-shell">
          <div class="chat-head">
            <button class="menu-toggle" type="button" id="menuToggle" style="margin-right:2px">☰</button>
            <a href="/groups" style="color:var(--dim);text-decoration:none;font-size:1.1rem">←</a>
            <div class="conv-av group-av">👥</div>
            <div class="chat-title"><%= group.name %> <span style="color:var(--dim);font-weight:400;font-size:.78rem">· <%= members.length %> membres</span></div>
          </div>
          <div class="chat-messages" id="chatMessages">
            <% if (!messages.length) { %><div class="chat-empty">Aucun message dans ce groupe encore 👋</div><% } %>
            <% messages.forEach(function(m){ %>
              <div class="msg-row <%= m.sender_id === meId ? 'mine' : 'theirs' %>">
                <% if (m.sender_id !== meId) { %><div class="msg-sender"><%= m.sender_name %></div><% } %>
                <% if (m.media_key) { %>
                  <% if ((m.media_mime||'').startsWith('image/')) { %>
                    <a href="/api/messages/<%= m.id %>/media" target="_blank"><img class="msg-media" src="/api/messages/<%= m.id %>/media" loading="lazy" /></a>
                  <% } else if ((m.media_mime||'').startsWith('video/')) { %>
                    <video class="msg-media" src="/api/messages/<%= m.id %>/media" controls preload="metadata"></video>
                  <% } else { %>
                    <a class="msg-file" href="/api/messages/<%= m.id %>/media" target="_blank">📄 <%= m.media_name || 'Fichier' %></a>
                  <% } %>
                <% } %>
                <% if (m.content) { %><div class="msg-bubble"><%= m.content %></div><% } %>
                <div class="msg-time"><%= new Date(m.created_at).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) %></div>
              </div>
            <% }) %>
          </div>
          <form class="chat-input-row" id="chatForm">
            <button type="button" id="attachBtn" class="attach-btn" title="Joindre une photo, vidéo ou document"><%- icon('paperclip') %></button>
            <input type="file" id="mediaInput" accept="image/*,video/*,application/pdf,.doc,.docx,.txt" hidden />
            <input type="text" id="chatInput" placeholder="Écrire au groupe..." maxlength="2000" autocomplete="off" />
            <button type="submit">➤</button>
          </form>
          <div class="attach-preview" id="attachPreview" hidden>
            <span id="attachName"></span>
            <button type="button" id="attachCancel">✕</button>
          </div>
        </div>

        <div class="group-side">
          <h4>Membres (<%= members.length %>)</h4>
          <% members.forEach(function(m){ %>
            <div class="member-row">
              <a class="conv-av" href="/u/<%= m.username %>" style="<%= m.avatar_key ? 'background-image:url(/api/avatar/'+m.id+');background-size:cover' : '' %>"><%= m.avatar_key ? '' : m.username.slice(0,1).toUpperCase() %></a>
              <div class="mname">@<%= m.username %> <% if (m.id === group.owner_id) { %>👑<% } %></div>
              <% if (isOwner && m.id !== meId) { %><button data-remove="<%= m.id %>">Retirer</button><% } %>
            </div>
          <% }) %>
          <div class="add-member-row">
            <input type="text" id="addMemberInput" placeholder="Ajouter par pseudo" />
            <button type="button" id="addMemberBtn">＋</button>
          </div>
          <% if (isOwner) { %>
            <button class="btn btn-ghost" type="button" id="deleteGroupBtn" style="width:100%;margin-top:16px;font-size:.78rem">🗑️ Supprimer le groupe</button>
          <% } else { %>
            <button class="btn btn-ghost" type="button" id="leaveGroupBtn" style="width:100%;margin-top:16px;font-size:.78rem">Quitter le groupe</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="toast" id="toast"></div>
  <script src="/static/js/social.js?v=8"></script>
  <script>
    const groupId = <%= group.id %>;
    let since = <%= messages.length ? messages[messages.length-1].created_at : 0 %>;
    const box = document.getElementById('chatMessages');
    function mediaHtml(m) {
      if (!m.media_key && !m.media_mime) return '';
      const url = '/api/messages/' + m.id + '/media';
      if ((m.media_mime || '').startsWith('image/')) return `<a href="${url}" target="_blank"><img class="msg-media" src="${url}" loading="lazy" /></a>`;
      if ((m.media_mime || '').startsWith('video/')) return `<video class="msg-media" src="${url}" controls preload="metadata"></video>`;
      return `<a class="msg-file" href="${url}" target="_blank">📄 ${m.media_name || 'Fichier'}</a>`;
    }
    function addMsg(m) {
      const el = document.createElement('div');
      el.className = 'msg-row ' + (m.sender_id === <%= meId %> ? 'mine' : 'theirs');
      if (m.sender_id !== <%= meId %>) { const s = document.createElement('div'); s.className = 'msg-sender'; s.textContent = m.sender_name || ''; el.appendChild(s); }
      const media = mediaHtml(m);
      if (media) el.insertAdjacentHTML('beforeend', media);
      if (m.content) { const b = document.createElement('div'); b.className = 'msg-bubble'; b.textContent = m.content; el.appendChild(b); }
      const t = document.createElement('div'); t.className = 'msg-time'; t.textContent = new Date(m.created_at).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
      el.appendChild(t); box.appendChild(el);
      box.scrollTop = box.scrollHeight;
    }
    box.scrollTop = box.scrollHeight;

    const attachBtn = document.getElementById('attachBtn'), mediaInput = document.getElementById('mediaInput');
    const attachPreview = document.getElementById('attachPreview'), attachName = document.getElementById('attachName');
    attachBtn.addEventListener('click', () => mediaInput.click());
    mediaInput.addEventListener('change', () => {
      if (mediaInput.files[0]) { attachName.textContent = '📎 ' + mediaInput.files[0].name; attachPreview.hidden = false; }
    });
    document.getElementById('attachCancel').addEventListener('click', () => { mediaInput.value = ''; attachPreview.hidden = true; });

    document.getElementById('chatForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const content = input.value.trim();
      const file = mediaInput.files[0];
      if (!content && !file) return;
      input.value = ''; attachPreview.hidden = true;
      const fd = new FormData();
      fd.append('group_id', groupId);
      fd.append('content', content);
      if (file) fd.append('media', file);
      mediaInput.value = '';
      const r = await fetch('/api/messages/send', { method: 'POST', body: fd });
      const data = await r.json();
      if (r.ok) { addMsg({ id: data.id, sender_id: <%= meId %>, content, media_mime: data.media ? data.media.mime : '', media_name: data.media ? data.media.name : '', created_at: data.created_at }); since = data.created_at; }
      else alert(data.message || data.error || 'Erreur lors de l\'envoi');
    });
    async function poll() {
      try {
        const r = await fetch('/api/messages/poll?group=' + groupId + '&since=' + since);
        const data = await r.json();
        data.messages.forEach(m => { addMsg(m); since = m.created_at; });
      } catch (e) {}
      setTimeout(poll, 3000);
    }
    poll();

    let toastTimer = null;
    function showToast(msg, isError) {
      const t = document.getElementById('toast'); t.textContent = msg; t.style.color = isError ? '#fca5a5' : '';
      t.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
    }
    document.getElementById('addMemberBtn').addEventListener('click', async () => {
      const input = document.getElementById('addMemberInput'); const username = input.value.trim(); if (!username) return;
      const r = await fetch('/api/groups/' + groupId + '/members', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ username }) });
      const data = await r.json();
      if (!r.ok) return showToast(data.error, true);
      location.reload();
    });
    document.querySelectorAll('[data-remove]').forEach(btn => btn.addEventListener('click', async () => {
      if (!confirm('Retirer cette personne du groupe ?')) return;
      await fetch('/api/groups/' + groupId + '/members/remove', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ user_id: btn.dataset.remove }) });
      location.reload();
    }));
    const delBtn = document.getElementById('deleteGroupBtn');
    if (delBtn) delBtn.addEventListener('click', async () => {
      if (!confirm('Supprimer définitivement ce groupe ? Cette action est irréversible.')) return;
      await fetch('/api/groups/' + groupId + '/delete', { method: 'POST' });
      location.href = '/groups';
    });
    const leaveBtn = document.getElementById('leaveGroupBtn');
    if (leaveBtn) leaveBtn.addEventListener('click', async () => {
      if (!confirm('Quitter ce groupe ?')) return;
      await fetch('/api/groups/' + groupId + '/leave', { method: 'POST' });
      location.href = '/groups';
    });
  </script>
</body>
</html>
