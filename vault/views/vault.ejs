<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><link rel="icon" href="/static/img/favicon.png" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0b0e14" />
<link rel="manifest" href="/manifest.json" />
<title><%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
<link rel="stylesheet" href="/static/css/vault.css" />
</head>
<body data-theme="<%= me.theme || 'dark' %>">
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="app">
    <%- include('_sidebar', { active: 'files', showNewBtn: true, showQuota: true }) %>

    <div class="main">
      <div class="topbar">
        <button class="menu-toggle" type="button" id="menuToggle">☰</button>
        <div class="breadcrumb" id="breadcrumb">
          <span data-folder="">Mes fichiers</span>
          <% breadcrumb.forEach(function(b){ %><span class="sep">›</span><span data-folder="<%= b.id %>"><%= b.name %></span><% }) %>
        </div>
        <div class="search"><span>🔎</span><input type="text" placeholder="Rechercher..." id="searchInput"></div>
        <a class="avatar" href="/account" title="Mon compte"><%= me.username.slice(0,1).toUpperCase() %></a>
      </div>

      <div class="content" id="content" data-folder="<%= currentFolder || '' %>">
        <div class="section-label"><%= folders.length + files.length %> élément<%= (folders.length+files.length) === 1 ? '' : 's' %></div>
        <div class="grid" id="grid">
          <% folders.forEach(function(f){ %>
            <div class="item" data-type="folder" data-id="<%= f.id %>" data-name="<%= f.name %>">
              <div class="thumb" style="background:rgba(59,130,246,.12)">📁</div>
              <div class="name"><%= f.name %></div>
              <div class="meta">Dossier</div>
              <button class="more" type="button">⋮</button>
            </div>
          <% }) %>
          <% files.forEach(function(f){ %>
            <div class="item" data-type="file" data-id="<%= f.id %>" data-name="<%= f.name %>">
              <div class="thumb">
                <% if (f.mime && f.mime.startsWith('image/')) { %>
                  <img src="/api/preview/<%= f.id %>" loading="lazy" alt="" />
                <% } else if (f.mime && f.mime.startsWith('video/')) { %>
                  <video src="/api/preview/<%= f.id %>" preload="metadata" muted></video>
                  <span class="play-badge">▶</span>
                <% } else { %>📄<% } %>
              </div>
              <div class="name"><%= f.name %></div>
              <div class="meta"><%= fmtBytes(f.size) %> · <%= new Date(f.created_at).toLocaleDateString('fr-FR') %></div>
              <button class="more" type="button">⋮</button>
            </div>
          <% }) %>
        </div>
        <% if (!folders.length && !files.length) { %>
          <div class="empty-state">
            <div style="font-size:2.4rem;margin-bottom:10px">📭</div>
            <div>Ce dossier est vide</div>
            <p style="color:var(--dim);font-size:.82rem;margin-top:6px">Glisse un fichier ici, ou clique sur "＋ Nouveau"</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="ctx-menu" id="ctxMenu">
    <button type="button" data-act="share">🔗 Partager</button>
    <button type="button" data-act="download">⬇️ Télécharger</button>
    <button type="button" data-act="rename">✏️ Renommer</button>
    <hr>
    <button type="button" class="danger" data-act="trash">🗑️ Mettre à la corbeille</button>
  </div>

  <div class="overlay" id="shareOverlay">
    <div class="modal">
      <h3>Partager "<span id="shareFileName"></span>"</h3>
      <p class="sub">N'importe qui avec le lien peut le voir et le télécharger.</p>
      <div class="link-row">
        <input type="text" readonly id="shareLink" value="">
        <button type="button" id="copyLinkBtn">Copier</button>
      </div>
      <button class="btn-ghost btn" type="button" id="revokeShareBtn" style="margin-bottom:18px">Révoquer ce lien</button>

      <div style="border-top:1px solid var(--border);padding-top:16px;margin-bottom:16px">
        <p class="sub" style="margin-bottom:10px">Ou partage-le directement à un autre utilisateur du site :</p>
        <div class="link-row">
          <input type="text" id="shareUsernameInput" placeholder="pseudo de la personne">
          <button type="button" id="shareUserBtn">Partager</button>
        </div>
      </div>

      <button class="modal-close" type="button" id="closeShareModal">Fermer</button>
    </div>
  </div>

  <div class="dropzone" id="dropzone">
    <div class="dzicon">📥</div>
    <div class="dztxt">Dépose ici pour importer</div>
  </div>

  <div class="upload-toast" id="uploadToast" hidden>
    <div class="ut-name" id="utName">Envoi en cours...</div>
    <div class="ut-track"><div class="ut-fill" id="utFill"></div></div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/static/js/vault.js"></script>
</body>
</html>
