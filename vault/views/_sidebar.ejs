<aside class="sidebar" id="sidebar">
  <div class="brand"><img class="logo" src="/static/img/logo.png" alt="" /> <%= siteName %></div>
  <% if (typeof showNewBtn !== 'undefined' && showNewBtn) { %>
    <div class="new-btn">
      <button type="button" id="newBtn"><%- icon('plus') %> Nouveau</button>
      <div class="new-menu" id="newMenu">
        <button type="button" id="menuUploadFile"><%- icon('upload') %> Importer un fichier</button>
        <button type="button" id="menuNewFolder"><%- icon('folder-plus') %> Nouveau dossier</button>
      </div>
    </div>
    <input type="file" id="fileInput" hidden />
  <% } else { %>
    <div class="new-btn"><button type="button" disabled style="opacity:.35;cursor:default"><%- icon('plus') %> Nouveau</button></div>
  <% } %>

  <div class="nav-group-label">Espace</div>
  <nav class="nav">
    <a href="/" class="<%= active==='files'?'active':'' %>"><%- icon('folder') %> Mes fichiers</a>
    <a href="/shared-with-me" class="<%= active==='shared'?'active':'' %>"><%- icon('share') %> Partagés avec moi</a>
    <a href="/trash" class="<%= active==='trash'?'active':'' %>"><%- icon('trash') %> Corbeille</a>
  </nav>

  <div class="nav-group-label">Social</div>
  <nav class="nav">
    <a href="/friends" class="<%= active==='friends'?'active':'' %>"><%- icon('users') %> Amis</a>
    <a href="/messages" class="<%= active==='messages'?'active':'' %>"><%- icon('message') %> Discussions</a>
    <a href="/groups" class="<%= active==='groups'?'active':'' %>"><%- icon('grid') %> Groupes</a>
  </nav>

  <% if (typeof showQuota !== 'undefined' && showQuota) { %>
    <div class="quota">
      <div class="qlabel"><span>Stockage</span><span id="qPct"><%= Math.round(me.storage_used / me.storage_quota * 100) %>%</span></div>
      <div class="qtrack"><div class="qfill" style="width:<%= Math.min(100, Math.round(me.storage_used / me.storage_quota * 100)) %>%"></div></div>
      <div class="qtxt"><b><%= fmtBytes(me.storage_used) %></b> utilisés sur <%= fmtBytes(me.storage_quota) %></div>
    </div>
  <% } %>

  <div class="sidebar-foot" style="position:relative">
    <button type="button" class="icon-btn" id="notifBell" title="Notifications" style="position:relative">
      <%- icon('bell') %>
      <span class="notif-badge" id="notifBadge" hidden>0</span>
    </button>
    <div class="notif-panel" id="notifPanel">
      <div class="notif-panel-head">Notifications</div>
      <div class="notif-list" id="notifList"><div class="notif-empty">Chargement...</div></div>
    </div>
    <a class="avatar" href="/account" title="Mon compte" style="<%= me.avatar_key ? 'background-image:url(/api/avatar/'+me.id+');background-size:cover' : '' %>"><%= me.avatar_key ? '' : me.username.slice(0,1).toUpperCase() %></a>
    <a href="/settings" class="icon-btn" title="Réglages"><%- icon('settings') %></a>
    <form method="POST" action="/logout" style="flex:1">
      <button class="icon-btn" type="submit" title="Déconnexion" style="width:100%"><%- icon('log-out') %></button>
    </form>
  </div>
</aside>
