<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= file.name %> · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
<style>
  .share-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
  .share-card{width:100%;max-width:440px;background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:28px;text-align:center}
  .share-icon{font-size:3rem;margin-bottom:14px}
  .share-card h2{font-size:1.05rem;margin-bottom:6px;word-break:break-word}
  .share-card .meta{color:var(--dim);font-size:.82rem;margin-bottom:22px}
  .share-preview{width:100%;max-height:280px;object-fit:contain;border-radius:10px;margin-bottom:18px;background:var(--panel-2)}
</style>
</head>
<body>
<div class="share-wrap">
  <div class="share-card">
    <% if (file.mime && file.mime.startsWith('image/')) { %>
      <img class="share-preview" src="/s/<%= token %>/download" alt="" />
    <% } else { %>
      <div class="share-icon"><%= file.mime && file.mime.startsWith('video/') ? '🎬' : '📄' %></div>
    <% } %>
    <h2><%= file.name %></h2>
    <div class="meta">Partagé via <%= siteName %> · <%= fmtBytes(file.size) %></div>
    <a class="btn" href="/s/<%= token %>/download">⬇️ Télécharger</a>
  </div>
</div>
</body>
</html>
