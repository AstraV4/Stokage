<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" /><link rel="icon" href="/static/img/favicon.png" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= file.name %> · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css?v=8" />
<style>
  .share-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
  .share-card{width:100%;max-width:480px;background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:26px;text-align:center}
  .share-brand{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:18px;font-size:.82rem;color:var(--dim);font-weight:600}
  .share-brand img{width:20px;height:20px;border-radius:6px}
  .share-icon{font-size:3rem;margin:20px 0}
  .share-card h2{font-size:1.05rem;margin-bottom:6px;word-break:break-word}
  .share-card .meta{color:var(--dim);font-size:.82rem;margin-bottom:22px}
  .share-preview{width:100%;max-height:340px;object-fit:contain;border-radius:12px;margin-bottom:18px;background:var(--panel-2);display:block}
</style>
</head>
<body>
<div class="share-wrap">
  <div class="share-card">
    <div class="share-brand"><img src="/static/img/logo.png" alt="" /> Partagé via <%= siteName %></div>
    <% if (file.mime && file.mime.startsWith('image/')) { %>
      <img class="share-preview" src="/s/<%= token %>/preview" alt="" />
    <% } else if (file.mime && file.mime.startsWith('video/')) { %>
      <video class="share-preview" src="/s/<%= token %>/preview" controls preload="metadata"></video>
    <% } else { %>
      <div class="share-icon">📄</div>
    <% } %>
    <h2><%= file.name %></h2>
    <div class="meta"><%= fmtBytes(file.size) %></div>
    <a class="btn" href="/s/<%= token %>/download">⬇️ Télécharger</a>
  </div>
</div>
</body>
</html>
